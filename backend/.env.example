# ─── Ledger Backend Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in values

# Server
PORT=5000
NODE_ENV=development

# JWT Secret (generate a strong random string for production)
JWT_SECRET=ledger_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h

# Google Gemini AI (for real AI summaries - leave blank to use deterministic engine)
GEMINI_API_KEY=

# AWS (for real AWS integration - leave blank to use mock layer)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=underwriter-ai
AWS_KMS_KEY_ID=

# Email Notifications (leave blank to use audit log simulation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ledger-insurance.com

# CORS allowed origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

# MS SQL Server Configuration
USE_MSSQL=false
MSSQL_SERVER=localhost
MSSQL_DATABASE=UnderwriterDB
MSSQL_USER=sa
MSSQL_PASSWORD=YourPassword123!
MSSQL_PORT=1433
MSSQL_ENCRYPT=false

